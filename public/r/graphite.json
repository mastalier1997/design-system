{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "graphite",
  "type": "registry:theme",
  "title": "Graphite theme",
  "description": "Graphite colours, type and radius for light and dark mode, plus 44px touch targets.",
  "cssVars": {
    "theme": {
      "font-sans": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
      "text-display": "2rem",
      "text-display--line-height": "2.375rem",
      "text-display--font-weight": "700",
      "text-h2": "1.375rem",
      "text-h2--line-height": "1.75rem",
      "text-h2--font-weight": "600",
      "text-body": "1rem",
      "text-body--line-height": "1.5rem",
      "text-label": "0.8125rem",
      "text-label--line-height": "1.125rem",
      "text-label--font-weight": "600",
      "text-label--letter-spacing": "0.02em",
      "text-caption": "0.8125rem",
      "text-caption--line-height": "1.125rem"
    },
    "light": {
      "radius": "0.625rem",
      "background": "#FFFFFF",
      "foreground": "#12171B",
      "card": "#EEF1F2",
      "card-foreground": "#12171B",
      "popover": "#FFFFFF",
      "popover-foreground": "#12171B",
      "primary": "#6656C8",
      "primary-foreground": "#FFFFFF",
      "secondary": "#E3E7E9",
      "secondary-foreground": "#12171B",
      "muted": "#EEF1F2",
      "muted-foreground": "#5B6570",
      "accent": "#E3E7E9",
      "accent-foreground": "#12171B",
      "destructive": "#C93030",
      "success": "#13703F",
      "border": "#D8DDE0",
      "input": "#8B949E",
      "ring": "#6656C8",
      "chart-1": "#6656C8",
      "chart-2": "#2F7FC9",
      "chart-3": "#13703F",
      "chart-4": "#B5772A",
      "chart-5": "#C25A7F",
      "sidebar": "#EEF1F2",
      "sidebar-foreground": "#12171B",
      "sidebar-primary": "#6656C8",
      "sidebar-primary-foreground": "#FFFFFF",
      "sidebar-accent": "#E3E7E9",
      "sidebar-accent-foreground": "#12171B",
      "sidebar-border": "#D8DDE0",
      "sidebar-ring": "#6656C8"
    },
    "dark": {
      "background": "#0C0F12",
      "foreground": "#E7ECEE",
      "card": "#141A1F",
      "card-foreground": "#E7ECEE",
      "popover": "#1C242B",
      "popover-foreground": "#E7ECEE",
      "primary": "#9084DA",
      "primary-foreground": "#0C0F12",
      "secondary": "#1C242B",
      "secondary-foreground": "#E7ECEE",
      "muted": "#141A1F",
      "muted-foreground": "#8B96A1",
      "accent": "#1C242B",
      "accent-foreground": "#E7ECEE",
      "destructive": "#F25555",
      "success": "#34C77B",
      "border": "#232B32",
      "input": "#5D6872",
      "ring": "#9084DA",
      "chart-1": "#9084DA",
      "chart-2": "#5596DC",
      "chart-3": "#34C77B",
      "chart-4": "#EACC56",
      "chart-5": "#DA7BB3",
      "sidebar": "#141A1F",
      "sidebar-foreground": "#E7ECEE",
      "sidebar-primary": "#9084DA",
      "sidebar-primary-foreground": "#0C0F12",
      "sidebar-accent": "#1C242B",
      "sidebar-accent-foreground": "#E7ECEE",
      "sidebar-border": "#232B32",
      "sidebar-ring": "#9084DA"
    }
  },
  "css": {
    "@layer base": {
      "html": {
        "color-scheme": "light"
      },
      "html.dark": {
        "color-scheme": "dark"
      },
      "@media (pointer: coarse)": {
        "[data-slot=\"button\"], [data-slot=\"input\"], [data-slot=\"select-trigger\"], [data-slot=\"tabs-trigger\"]": {
          "min-height": "2.75rem"
        },
        "[data-slot=\"button\"]": {
          "min-width": "2.75rem"
        }
      },
      "@media (prefers-reduced-motion: reduce)": {
        "*, *::before, *::after": {
          "animation-duration": "0.01ms !important",
          "transition-duration": "0.01ms !important"
        }
      }
    }
  }
}
