  "type": {
    "fonts": [],
    "families": {
      "sans": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
    },
    "groups": [
      {
        "name": "Headings",
        "family": "sans",
        "styles": [
          {
            "name": "display",
            "fontSize": "32px",
            "lineHeight": "38px",
            "fontWeight": 700,
            "sample": "Choose your split",
            "usage": "Screen title, one per screen (Tailwind: text-display)."
          },
          {
            "name": "h2",
            "fontSize": "22px",
            "lineHeight": "28px",
            "fontWeight": 600,
            "sample": "Push day · 5 exercises",
            "usage": "Section headers, card titles that lead (text-h2)."
          }
        ]
      },
      {
        "name": "Text",
        "family": "sans",
        "styles": [
          {
            "name": "body",
            "fontSize": "16px",
            "lineHeight": "24px",
            "fontWeight": 400,
            "sample": "Body text for inputs and descriptions.",
            "usage": "Default copy and input text (text-body). Inputs stay 16px so iOS doesn't zoom."
          },
          {
            "name": "body-medium",
            "fontSize": "16px",
            "lineHeight": "24px",
            "fontWeight": 500,
            "sample": "Romanian deadlift",
