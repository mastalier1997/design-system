            "usage": "Tags and small labels, always uppercase (text-label uppercase)."
          },
          {
            "name": "caption",
            "fontSize": "13px",
            "lineHeight": "18px",
            "fontWeight": 400,
            "sample": "Last time 60 kg",
            "usage": "Captions, helper text, metadata. 13px is the floor for any UI text."
          }
        ]
      }
    ]
